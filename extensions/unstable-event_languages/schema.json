{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/openajang/extensions/unstable-event_languages/schema.json",
  "title": "unstable:event_languages value (worked candidate)",
  "description": "Event-wide languages. Each array holds BCP 47 tags. The tag syntax check lives in PROFILE.md because plain JSON Schema has no BCP 47 format.",
  "type": "object",
  "properties": {
    "working": { "$ref": "#/$defs/tags" },
    "presentations": { "$ref": "#/$defs/tags" }
  },
  "minProperties": 1,
  "additionalProperties": true,
  "$defs": {
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
