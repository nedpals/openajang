---
import { readdirSync } from 'node:fs';
interface Props {
  title: string;
  description?: string;
  sidebar?: boolean;
}
const { title, description = 'A small JSON format for publishing public events at a URL.', sidebar = false } = Astro.props;
const examples = readdirSync(new URL('../../../../examples/', import.meta.url)).filter((f) => f.endsWith('.openajang.json'));
const nav = [
  { href: '/spec/', label: 'Spec' },
  { href: '/validator/', label: 'Validator' },
  { href: '/examples/', label: 'Examples' },
  { href: '/feeds/', label: 'Feeds' },
  { href: 'https://github.com/nedpals/openajang', label: 'GitHub' }
];
---
<!doctype html>
<html lang="en" data-examples={examples.join(',')}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 32 32%27%3E%3Crect width=%2732%27 height=%2732%27 rx=%276%27 fill=%27%232b2a47%27/%3E%3Ctext x=%2716%27 y=%2723%27 font-size=%2720%27 font-family=%27sans-serif%27 font-weight=%27700%27 text-anchor=%27middle%27 fill=%27%23d36138%27%3EA%3C/text%3E%3C/svg%3E" />
    <link rel="preload" href="/fonts/MerriweatherSans.ttf" as="font" type="font/ttf" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <div class="navbar-inner">
      <a class="brand" href="/">OpenAjang</a>
      <nav>{nav.map((n) => <a href={n.href}>{n.label}</a>)}</nav>
      </div>
    </header>
    <main class:list={{ home: title === 'OpenAjang', 'with-sidebar': sidebar }}><slot /></main>
    <footer>
      <div class="footer-inner">
        <div>
          <a class="footer-brand" href="/">OpenAjang</a>
          <p>Working draft, version 0.1.</p>
        </div>
        <div>
          <nav aria-label="Project links">
            <a href="/spec/">Specification</a>
            <a href="https://github.com/nedpals/openajang">Source code</a>
            <a href="https://github.com/nedpals/openajang/issues">Issues and feedback</a>
          </nav>
          <p>Spec under <a href="https://github.com/nedpals/openajang/blob/master/LICENSE-docs">LICENSE-docs</a>. Code under <a href="https://github.com/nedpals/openajang/blob/master/LICENSE">Apache-2.0</a>.</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Merriweather Sans';
    src: url(/fonts/MerriweatherSans.ttf) format('truetype');
    font-weight: 300 800;
    font-display: swap;
  }

  :root {
    color-scheme: light dark;
    --bg: #fff;
    --fg: #333;
    --heading: #2b2a47;
    --muted: #626262;
    --line: #ddd;
    --accent: #9b401f;
    --code: #f5f5f5;
    --panel: #f5f5f5;
    --bad: #a32222;
    --good: #23633b;
    --control-top: #fff;
    --control-bottom: #e9e9e9;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1d1c26;
      --fg: #eeeaf0;
      --heading: #f2edf6;
      --muted: #c1bac5;
      --line: #514c58;
      --accent: #ffae8f;
      --code: #302d38;
      --panel: #292731;
      --bad: #ffaaa3;
      --good: #a4ddb3;
      --control-top: #403c49;
      --control-bottom: #302d38;
    }
  }

  * { box-sizing: border-box; }
  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    color: var(--fg);
    font: 350 15px/1.65 'Merriweather Sans', sans-serif;
  }
  main, .footer-inner, .navbar-inner {
    max-width: 48rem;
    margin: 0 auto;
    padding: 1rem 1.25rem;
  }
  main { width: 100%; flex: 1; }
  main.home { max-width: none; padding: 0; }
  main.with-sidebar { max-width: 56.5rem; }
  .footer-inner, .navbar-inner { max-width: 56.5rem; }
  header { background: #2b2a47; }
  .navbar-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: .25rem 1.5rem;
    min-height: 3.5rem;
    padding-top: .5rem;
    padding-bottom: .5rem;
  }
  header nav { display: flex; flex-wrap: wrap; gap: .25rem 1.25rem; }
  header a { color: #dddce8; font-weight: 400; text-decoration: none; padding: .35rem 0; }
  header a:hover, header a:focus-visible { color: #fff; text-decoration: underline; }
  .brand { font-size: 1.15rem; font-weight: 700; color: #fff; }
  a { color: var(--accent); text-underline-offset: .18em; overflow-wrap: anywhere; }
  a:hover { text-decoration-thickness: 2px; }
  :focus-visible { outline: 3px solid #d36138; outline-offset: 3px; }
  ::selection { background: #2b2a47; color: #fff; }
  footer {
    border-top: 1px solid var(--line);
    background: var(--panel);
    color: var(--muted);
    font-size: .8rem;
    margin-top: 2rem;
  }
  .footer-inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem 2rem; padding-top: 1.75rem; padding-bottom: 1.75rem; }
  .footer-brand { display: inline-block; color: var(--heading); font-size: 1.1rem; font-weight: 600; text-decoration: none; margin-bottom: .25rem; }
  footer p { margin: .5rem 0 0; }
  footer nav { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; }
  [id] { scroll-margin-top: 1rem; }
  pre, code { background: var(--code); border-radius: 4px; font: .9em/1.5 ui-monospace, monospace; }
  code { padding: .1em .3em; overflow-wrap: anywhere; }
  pre { padding: 1rem; overflow-x: auto; border: 1px solid var(--line); }
  pre code { padding: 0; background: none; }
  table { border-collapse: collapse; display: block; overflow-x: auto; }
  th, td { border: 1px solid var(--line); padding: .4rem .65rem; text-align: left; }
  strong, b { font-weight: 600; }
  h1, h2, h3 { color: var(--heading); font-weight: 600; line-height: 1.3; }
  h1 { font-size: 2.25rem; font-weight: 700; margin: 1rem 0; }
  h2 { font-size: 1.5rem; margin: 0 0 .75rem; }
  h3 { font-size: 1.15rem; font-weight: 500; }
  p { margin: 0 0 1rem; }
  button, .button {
    display: inline-block;
    font: 400 .95rem/1.4 'Merriweather Sans', sans-serif;
    background: linear-gradient(#444360, #2b2a47);
    color: #fff;
    border: 1px solid #25243e;
    border-radius: 4px;
    padding: .45rem .8rem;
    cursor: pointer;
    text-decoration: none;
  }
  button:hover, .button:hover { background: #393853; text-decoration: none; }
  button:active, .button:active { background: #25243e; }
  button:disabled { opacity: 1; cursor: wait; }
  button[type='submit'] { color: #fff; -webkit-text-fill-color: #fff; }
  button[type='submit']:disabled { background: #393853; }
  input, select, textarea {
    font: inherit;
    color: var(--fg);
    background: var(--bg);
    border: 1px solid #888;
    border-radius: 4px;
    padding: .45rem .6rem;
  }
  input::placeholder, textarea::placeholder { color: var(--muted); opacity: 1; }
</style>
