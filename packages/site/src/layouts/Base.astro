---
import { readdirSync } from 'node:fs';
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'A small JSON format for publishing public events at a URL.' } = Astro.props;
const examples = readdirSync(new URL('../../../../examples/', import.meta.url)).filter((f) => f.endsWith('.openajang.json'));
const nav = [
  { href: '/spec/', label: 'Spec' },
  { href: '/validator/', label: 'Validator' },
  { href: '/examples/', label: 'Examples' },
  { href: '/feeds/', label: 'Feeds' },
  { href: 'https://github.com/nedpals/openajang', label: 'GitHub' }
];
---
<!doctype html>
<html lang="en" data-examples={examples.join(',')}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 32 32%27%3E%3Crect width=%2732%27 height=%2732%27 rx=%276%27 fill=%27%232b2a47%27/%3E%3Ctext x=%2716%27 y=%2723%27 font-size=%2720%27 font-family=%27sans-serif%27 font-weight=%27700%27 text-anchor=%27middle%27 fill=%27%23d36138%27%3EA%3C/text%3E%3C/svg%3E" />
    <link rel="preload" href="/fonts/MerriweatherSans.ttf" as="font" type="font/ttf" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <a class="brand" href="/">OpenAjang</a>
      <nav>{nav.map((n) => <a href={n.href}>{n.label}</a>)}</nav>
    </header>
    <main class:list={{ home: title === 'OpenAjang' }}><slot /></main>
    <footer>
      <p>Working draft, version 0.1. Spec under <a href="https://github.com/nedpals/openajang/blob/master/LICENSE-docs">LICENSE-docs</a>, code under Apache-2.0.</p>
    </footer>
  </body>
</html>

<style is:global>
  @font-face { font-family: Merriweather Sans; src: url(/fonts/MerriweatherSans.ttf) format("truetype"); font-weight: 300 800; font-display: swap; }
  :root { color-scheme: light dark; --bg:#faf9f6; --fg:#292839; --heading:#2b2a47; --muted:#5e5c65; --line:#d9d6d1; --accent:#9b401f; --code:#efede9; --bad:#a32222; --good:#23633b; --panel:#f1efeb; }
  @media (prefers-color-scheme: dark) { :root { --bg:#1d1c26; --fg:#eeeaf0; --heading:#f2edf6; --muted:#c1bac5; --line:#514c58; --accent:#ffae8f; --code:#302d38; --bad:#ffaaa3; --good:#a4ddb3; --panel:#292731; } }
  * { box-sizing:border-box; }
  body { margin:0; background:var(--bg); color:var(--fg); font:16px/1.7 'Merriweather Sans',sans-serif; }
  header, main, footer { max-width:48rem; margin:auto; padding:1.25rem; }
  main.home { max-width:56.5rem; }
  header { max-width:56.5rem; display:flex; flex-wrap:wrap; gap:.5rem 2rem; align-items:baseline; justify-content:space-between; border-bottom:3px solid #d36138; }
  header nav { display:flex; flex-wrap:wrap; gap:.5rem 1.1rem; }
  .brand { font-size:1.2rem; font-weight:800; color:var(--heading); text-decoration:none; }
  a { color:var(--accent); text-underline-offset:.18em; overflow-wrap:anywhere; }
  a:hover { text-decoration-thickness:2px; }
  :focus-visible { outline:3px solid #d36138; outline-offset:3px; }
  ::selection { background:#d36138; color:white; }
  footer { max-width:56.5rem; border-top:1px solid var(--line); color:var(--muted); font-size:.85rem; margin-top:3rem; }
  pre, code { background:var(--code); border-radius:3px; font: .9em/1.5 ui-monospace, monospace; }
  code { padding:.1em .3em; } pre { padding:1rem; overflow-x:auto; } pre code { padding:0; background:none; }
  table { border-collapse:collapse; display:block; overflow-x:auto; } th,td { border:1px solid var(--line); padding:.3rem .6rem; text-align:left; }
  h1,h2,h3 { color:var(--heading); line-height:1.25; text-wrap:balance; } h1 { font-size:clamp(2.2rem,5vw,3.5rem); letter-spacing:-.025em; } h2 { font-size:1.65rem; }
  button,.button { display:inline-block; font:700 1rem/1.3 'Merriweather Sans',sans-serif; background:linear-gradient(#444360,#2b2a47); color:#fff; border:1px solid #2b2a47; border-bottom:4px solid #19182e; border-radius:3px; padding:.65rem 1rem; cursor:pointer; text-decoration:none; }
  button:hover,.button:hover { background:#393853; } button:active,.button:active { transform:translateY(2px); border-bottom-width:2px; } button:disabled { opacity:1; cursor:wait; }
  button[type="submit"], button[type="submit"]:hover, button[type="submit"]:focus, button[type="submit"]:disabled { color:#fff; -webkit-text-fill-color:#fff; }
  button[type="submit"]:disabled { background:#393853; border-color:#2b2a47; border-bottom-color:#19182e; }
  input,select,textarea { font:inherit; color:var(--fg); background:var(--bg); border:1px solid var(--muted); border-radius:3px; padding:.6rem; }
</style>
