---
import {
  BookOpen,
  CalendarDays,
  CodeXml,
  Download,
  FileBraces,
  Link,
  List,
  MessageSquareText,
  SquareCheck,
  UserRound,
} from '@lucide/astro';

const icons = {
  book: BookOpen,
  calendar: CalendarDays,
  check: SquareCheck,
  code: CodeXml,
  download: Download,
  file: FileBraces,
  link: Link,
  list: List,
  message: MessageSquareText,
  person: UserRound,
};

interface Props {
  name: keyof typeof icons;
  size?: number;
}
const { name, size = 20 } = Astro.props;
const LucideIcon = icons[name];
---

<LucideIcon class="icon" size={size} stroke-width={1.75} aria-hidden="true" focusable="false" />

<style is:global>
  .icon {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: -0.15em;
  }
</style>
