---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base
  title="Event builder"
  description="Create and publish an OpenAjang event in your browser."
  wide
>
  <h1>Event builder</h1>
  <div class="builder-intro">
    <p>
      Fill in the form to make an OpenAjang event file, or open one you already have. Nothing leaves
      your browser. OpenAjang is a version 0.1 working draft, so the format may still change.
    </p>
    <p>
      Drafts are not saved automatically, so use Save draft before you close the tab. When the event
      passes validation, download it and upload the file to your own website.
    </p>
    <p class="reference-links">
      <a href="/docs/publish-your-first-event/">Publish your first event</a>
      <a href="/spec/">Read the specification</a>
      <a href="/validator/">Check an existing file</a>
    </p>
  </div>
  <noscript>
    <p>JavaScript is required to use the event builder.</p>
  </noscript>
  <div class="toolbar">
    <button type="button" class="secondary" id="open-file">
      <Icon name="file" size={18} />Open JSON file
    </button>
    <input
      id="import"
      type="file"
      accept=".json,application/json,application/vnd.openajang+json"
      aria-label="Open event or draft JSON"
      hidden
    />
    <button type="button" class="secondary" id="save-draft">Save draft</button>
    <button type="button" class="secondary" id="new">New event</button>
    <span id="notice" role="status"></span>
  </div>
  <p class="hint">Files can be up to 1 MiB for events and 4 MiB for drafts.</p>
  <p class="mobile-jump">
    <a href="#preview-panel">
      Output &amp; export <span id="mobile-error-count"></span>
    </a>
  </p>
  <div class="builder">
    <form id="builder-form" novalidate>
      <p class="hint">Fields marked "required" must be filled in. Everything else is optional.</p>
      <fieldset>
        <legend>Event details</legend>
        <label>
          Event title (required) <input name="title" required />
        </label>
        <label>
          Short summary <textarea name="summary" rows="3"></textarea>
        </label>
        <details class="optional-group" data-fields="description,language,tags">
          <summary>
            More event details <span data-detail-indicator></span>
          </summary>
          <label>
            Full description <textarea name="description" rows="5"></textarea>
          </label>
          <label>
            Event language <input name="language" placeholder="e.g. en or fil" />
          </label>
          <label>
            Tags (one per line) <textarea name="tags" rows="2"></textarea>
          </label>
        </details>
        <label>
          Event page URL (required){' '}
          <input name="url" type="url" placeholder="https://example.org/event/" required />
        </label>
        <label>
          Organizer name (required) <input name="organizer.name" required />
        </label>
        <details class="optional-group" data-fields="organizer.url,organizer.email,organizer.phone">
          <summary>
            Organizer contact details <span data-detail-indicator></span>
          </summary>
          <label>
            Organizer URL <input name="organizer.url" type="url" />
          </label>
          <label>
            Organizer email <input name="organizer.email" type="email" />
          </label>
          <label>
            Organizer phone <input name="organizer.phone" type="tel" />
          </label>
        </details>
      </fieldset>
      <fieldset id="time-zone-settings">
        <legend>Time zone</legend>
        <label>
          Time zone for this event
          <input
            name="time_zone"
            list="time-zones"
            autocomplete="off"
            placeholder="e.g. Asia/Manila"
            aria-describedby="zone-help"
          />
        </label>
        <datalist id="time-zones"></datalist>
        <p class="hint" id="zone-help">
          Applies to the event times, registration times and earlier start times. A date without a time needs no zone.
        </p>
        <p id="zone-suggestion" class="hint"></p>
        <button type="button" id="use-zone" class="secondary" hidden>
          Use my detected time zone
        </button>
        <details class="optional-group">
          <summary>About imported times</summary>
          <p class="hint">
            Changing the zone recalculates times you edited here. Times from an imported file stay as they were until you edit that date or time.
          </p>
        </details>
      </fieldset>
      <fieldset>
        <legend>Dates and time</legend>
        <p class="hint">
          Leave the time blank if it is not known yet. A date alone does not mean an all-day event.
        </p>
        <input type="hidden" name="starts_at" />
        <input type="hidden" name="ends_at" />
        <div class="date-controls">
          <label>
            Start date (required) <input type="date" id="start-date" required />
          </label>
          <label>
            Start time (optional) <input type="time" id="start-time" step="1" aria-describedby="start-time-help" />
          </label>
          <div id="start-offset-group" hidden>
            <label>
              Choose start time offset <select id="start-offset"></select>
            </label>
          </div>
          <p id="start-zone-context" class="hint" data-time-zone-context></p>
          <p id="start-time-help" class="hint"></p>
        </div>
        <div class="date-controls">
          <label>
            End date (optional) <input type="date" id="end-date" />
          </label>
          <label>
            End time (optional) <input type="time" id="end-time" step="1" aria-describedby="end-time-help" />
          </label>
          <div id="end-offset-group" hidden>
            <label>
              Choose end time offset <select id="end-offset"></select>
            </label>
          </div>
          <p id="end-zone-context" class="hint" data-time-zone-context></p>
          <p id="end-time-help" class="hint"></p>
        </div>
        <p class="hint">Give both start and end a time, or neither.</p>
      </fieldset>
      <fieldset>
        <legend>Location</legend>
        <label>
          How people attend{' '}
          <select name="location.type">
            <option value="physical">In person</option>
            <option value="virtual">Online</option>
            <option value="hybrid">Hybrid</option>
          </select>
        </label>
        <div id="physical-fields">
          <label>
            Is the venue confirmed?{' '}
            <select name="location.physical.status">
              <option value="">Not specified (treated as confirmed)</option>
              <option value="confirmed">Confirmed</option>
              <option value="tentative">Tentative</option>
              <option value="to_be_announced">To be announced</option>
            </select>
          </label>
          <label>
            Venue name (required unless the venue is to be announced) <input name="location.physical.name" />
          </label>
          <details
            class="optional-group"
            data-fields="location.physical.address,location.physical.instructions"
          >
            <summary>
              Venue address and instructions <span data-detail-indicator></span>
            </summary>
            <label>
              Street address <input name="location.physical.address.street" />
            </label>
            <label>
              City or locality <input name="location.physical.address.locality" />
            </label>
            <label>
              Region <input name="location.physical.address.region" />
            </label>
            <label>
              Postal code <input name="location.physical.address.postal_code" />
            </label>
            <label>
              Country code (2 letters){' '}
              <input name="location.physical.address.country" placeholder="e.g. PH" maxlength="2" />
            </label>
            <label>
              Venue instructions{' '}
              <textarea name="location.physical.instructions" rows="2"></textarea>
            </label>
          </details>
        </div>
        <div id="virtual-fields">
          <label>
            Online event link (required for online and hybrid events) <input name="location.virtual.url" type="url" />
          </label>
          <details
            class="optional-group"
            data-fields="location.virtual.platform,location.virtual.instructions"
          >
            <summary>
              Online joining details <span data-detail-indicator></span>
            </summary>
            <label>
              Online platform (e.g. Zoom) <input name="location.virtual.platform" />
            </label>
            <label>
              Joining instructions{' '}
              <textarea name="location.virtual.instructions" rows="2"></textarea>
            </label>
          </details>
        </div>
        <p class="hint">
          Changing how people attend keeps the details you entered until you remove them.
        </p>
        <div class="actions">
          <button class="secondary" type="button" id="clear-physical">
            Remove venue details
          </button>
          <button class="secondary" type="button" id="clear-virtual">
            Remove online details
          </button>
        </div>
      </fieldset>
      <fieldset>
        <legend>Event status</legend>
        <label>
          Status{' '}
          <select name="status" aria-describedby="status-help">
            <option value="scheduled">Scheduled</option>
            <option value="postponed">Postponed</option>
            <option value="rescheduled">Rescheduled</option>
            <option value="cancelled">Cancelled</option>
            <option value="completed">Completed</option>
          </select>
        </label>
        <p class="hint" id="status-help"></p>
        <label>
          Note for attendees <input name="status_note" />
        </label>
        <div id="history-label">
          <p>Earlier start dates (required for rescheduled events)</p>
          <p class="hint" id="history-help">List earlier starts from oldest to newest. A date alone is enough if the time was unknown.</p>
          <textarea name="previous_starts_at" hidden></textarea>
          <div id="history-list"></div>
          <button type="button" id="add-history" class="secondary">Add earlier start</button>
          <button type="button" id="add-previous" class="secondary" hidden>
            Add the imported start date to history
          </button>
        </div>
      </fieldset>
      <details class="optional-panel" data-fields="image">
        <summary>
          Event image <span data-detail-indicator></span>
        </summary>
        <fieldset>
          <legend class="sr-only">Event image</legend>
          <label>
            Image URL{' '}
            <input name="image.url" type="url" placeholder="https://example.org/image.jpg" />
          </label>
          <label>
            Image description (alt text) <input name="image.alt" aria-describedby="alt-help" />
          </label>
          <p id="alt-help" class="hint">
            Describe the image for someone who cannot see it. The published page loads the image from the URL.
          </p>
        </fieldset>
      </details>
      <details class="optional-panel" data-fields="registration">
        <summary>
          Registration <span data-detail-indicator></span>
        </summary>
        <fieldset>
          <legend class="sr-only">Registration</legend>
          <p class="hint" id="registration-help">
            Only fill this in if you want to publish registration details. Otherwise leave it as Not specified.
          </p>
          <label>
            Do attendees need to register?{' '}
            <select name="registration.required" aria-describedby="registration-help">
              <option value="">Not specified</option>
              <option value="true">Required</option>
              <option value="false">Not required</option>
            </select>
          </label>
          <label>
            Registration status{' '}
            <select name="registration.status">
              <option value="">Not specified</option>
              <option value="not_yet_open">Not yet open</option>
              <option value="open">Open</option>
              <option value="closed">Closed</option>
              <option value="waitlist">Waitlist</option>
              <option value="unknown">Unknown</option>
            </select>
          </label>
          <label>
            Registration URL <input name="registration.url" type="url" />
          </label>
          <p class="hint">Opening and closing times are optional. Each needs a date and a time, in the event time zone.</p>
          {['opens', 'closes'].map((boundary) => (
            <div class="date-controls">
              <input type="hidden" name={`registration.${boundary}_at`} />
              <label>Registration {boundary} date <input type="date" id={`registration-${boundary}-date`} /></label>
              <label>Registration {boundary} time <input type="time" step="1" id={`registration-${boundary}-time`} aria-describedby={`registration-${boundary}-time-help`} /></label>
              <div id={`registration-${boundary}-offset-group`} hidden><label>Choose offset <select id={`registration-${boundary}-offset`}></select></label></div>
              <p class="hint" id={`registration-${boundary}-zone-context`} data-time-zone-context></p>
              <p class="hint" id={`registration-${boundary}-time-help`}></p>
            </div>
          ))}
          <label>
            Registration instructions{' '}
            <textarea name="registration.instructions" rows="2"></textarea>
          </label>
        </fieldset>
      </details>
      <details class="optional-panel" data-fields="tickets">
        <summary>
          Tickets <span data-detail-indicator></span>
        </summary>
        <fieldset>
          <legend class="sr-only">Tickets</legend>
          <p class="hint">Price and availability are optional. A price needs both an amount and a currency.</p>
          <div id="ticket-list"></div>
          <button type="button" id="add-ticket" class="secondary">
            Add ticket
          </button>
        </fieldset>
      </details>
    </form>
    <aside class="side" id="preview-panel" aria-label="Output and export">
      <p class="mobile-jump">
        <a href="#builder-form">Back to event details</a>
      </p>
      <label for="generated-json" class="output-label">
        Your event file
      </label>
      <textarea
        id="generated-json"
        class="generated-output"
        rows="14"
        readonly
        spellcheck="false"
        aria-describedby="output-hint"
      ></textarea>
      <p id="output-hint" class="hint">
        The updated timestamp is set when you download.
      </p>
      <div class="validation-feedback">
        <p id="validation" role="status" aria-live="polite" aria-atomic="true"></p>
        <ul id="errors"></ul>
      </div>
      <div class="actions download-actions">
        <button id="json" type="button">
          <Icon name="download" size={18} />
          Download JSON
        </button>
        <button id="zip" type="button">
          <Icon name="download" size={18} />
          Download website files (ZIP)
        </button>
      </div>
      <p class="hint">The ZIP holds the JSON file and a ready-made event page. Upload either to your own website.</p>
      <p id="export-notice" role="status" aria-live="polite" aria-atomic="true"></p>
    </aside>
  </div>
</Base>
<script>
  import '../scripts/builder';
</script>
<style>
  :global(.event-image) {
    display: block;
    max-width: 100%;
    max-height: 18rem;
    object-fit: contain;
    border-radius: 3px;
  }
  :global(.history-editor label),
  :global(.ticket-editor label) {
    display: block;
    font-weight: 500;
    margin: 0.85rem 0;
  }
  :global(.history-editor input:not([type='hidden'])),
  :global(.history-editor select),
  :global(.ticket-editor input),
  :global(.ticket-editor textarea),
  :global(.ticket-editor select) {
    display: block;
    width: 100%;
    max-width: 100%;
    margin-top: 0.3rem;
    padding: 0.55rem;
    color: var(--fg);
    background: var(--bg);
    border: 1px solid var(--muted);
    border-radius: 3px;
    font: inherit;
    font-size: 1rem;
  }
  :global(.history-editor) {
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 1.25rem;
    margin: 1rem 0;
  }
  :global(.history-editor .hint) {
    color: var(--muted);
    font-size: 0.85rem;
    overflow-wrap: anywhere;
  }
  :global(.ticket-editor) {
    border-top: 1px solid var(--line);
    padding-top: 0.5rem;
    margin-top: 1rem;
  }
  .optional-panel {
    border: 1px solid var(--line);
    border-radius: 4px;
    margin: 0 0 1.25rem;
  }
  .optional-panel > summary {
    padding: 1rem 1.25rem;
    font-size: 1.15rem;
    font-weight: 700;
    cursor: pointer;
  }
  .optional-panel > fieldset {
    border: 0;
    margin: 0;
    padding-top: 0;
  }
  .optional-group {
    border-top: 1px solid var(--line);
    padding: 0.75rem 0;
    margin: 1rem 0;
  }
  .optional-group > summary {
    font-weight: 600;
    cursor: pointer;
  }
  [data-detail-indicator] {
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 400;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  [hidden] {
    display: none !important;
  }
  .secondary {
    background: linear-gradient(var(--control-top), var(--control-bottom));
    color: var(--fg);
    border-color: var(--line);
  }
  .secondary:hover {
    background: var(--code);
    border-color: var(--muted);
  }
  .builder-intro {
    max-width: 72ch;
  }
  .reference-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 0.9rem;
  }
  .toolbar,
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin: 1.5rem 0;
  }
  .toolbar {
    padding: 1rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 4px;
    margin-bottom: 0.5rem;
  }
  .download-actions {
    display: grid;
  }
  .download-actions button {
    width: 100%;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
  }
  .builder {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 2rem;
    align-items: start;
  }
  fieldset {
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 1.25rem;
    margin: 0 0 1.25rem;
    min-width: 0;
  }
  legend {
    font-size: 1.15rem;
    font-weight: 700;
    padding: 0 0.3rem;
  }
  label {
    display: block;
    font-weight: 500;
    margin: 0.85rem 0;
  }
  input:not([type='file']),
  select,
  textarea {
    display: block;
    width: 100%;
    max-width: 100%;
    margin-top: 0.3rem;
    padding: 0.55rem;
    color: var(--fg);
    background: var(--bg);
    border: 1px solid var(--muted);
    border-radius: 3px;
    font: inherit;
    font-size: 1rem;
  }
  textarea {
    resize: vertical;
  }
  .hint {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .side {
    position: sticky;
    top: calc(var(--builder-banner-height, 3rem) + 1rem);
    min-width: 0;
    max-height: calc(100vh - var(--builder-banner-height, 3rem) - 2rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .mobile-jump {
    display: none;
  }
  .output-label {
    margin-top: 0;
    font-size: 1.5rem;
  }
  textarea.generated-output {
    min-height: 12rem;
    padding: 1rem;
    font-family: monospace;
    font-size: 0.8rem;
    line-height: 1.5;
    white-space: pre;
    overflow: auto;
  }
  #preview-panel button:disabled { opacity: .55; cursor: not-allowed; }

  .validation-feedback {
    margin-top: 1rem;
  }
  #validation {
    font-weight: 500;
  }
  #validation[data-state='valid'] {
    color: var(--good);
  }
  #validation[data-state='invalid'] {
    color: var(--bad);
  }
  #errors {
    color: var(--bad);
    padding-left: 1.2rem;
    overflow-wrap: anywhere;
  }
  :global(.field-error) {
    display: block;
    color: var(--bad);
    font-size: 0.85rem;
    font-weight: 400;
  }
  :global([aria-invalid='true']) {
    border-color: var(--bad) !important;
  }
  @media (max-width: 800px) {
    .builder {
      grid-template-columns: 1fr;
    }
    .side {
      position: static;
      max-height: none;
      overflow: visible;
    }
    .mobile-jump {
      display: block;
    }
  }
</style>
