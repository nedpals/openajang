{
  "name": "@openajang/core",
  "version": "0.1.0-rc.4",
  "description": "Parser, schema and procedural validator, and conversions for the OpenAjang event format",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js",
      "default": "./dist/adapters.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/generate-schema.mjs && node ../../scripts/generate-validator.mjs && tsc -p tsconfig.json",
    "typecheck": "node ../../scripts/generate-schema.mjs && node ../../scripts/generate-validator.mjs && tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test tests/core.test.ts"
  },
  "dependencies": {
    "bcp-47": "^2.1.2",
    "ipaddr.js": "^2.5.0",
    "unicode-case-folding": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "24.0.7",
    "ical.js": "^2.2.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nedpals/openajang.git",
    "directory": "packages/core"
  }
}
